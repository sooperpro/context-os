{
  "name": "contextos",
  "version": "0.1.0",
  "private": true,
  "description": "ContextOS monorepo: React + shadcn/ui web app and Node (Hono) API with Gemini-powered analysis on SQLite",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=12.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm --filter @contextos/api start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graph:build": "graphify update .",
    "graph:tree": "graphify tree --root . --label ContextOS",
    "graph:query": "graphify query",
    "graph:explain": "graphify explain",
    "graph:affected": "graphify affected",
    "db:generate": "pnpm --filter @contextos/api db:generate",
    "db:migrate": "pnpm --filter @contextos/api db:migrate",
    "db:studio": "pnpm --filter @contextos/api db:studio",
    "ui:add": "pnpm --filter @contextos/web ui:add",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
