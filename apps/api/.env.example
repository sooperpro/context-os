# Copy to .env for local development. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug

# SQLite database file (directories are created automatically). Use ":memory:" for ephemeral.
DATABASE_URL=./data/contextos.db

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
# Daily AI generation limits per workspace: ContextOS's ceiling (the Owner can set lower ones).
# The automatic limit is the share of module drafts that start on their own (Hub updates).
AI_DAILY_TEMPLATE_LIMIT=5
AI_DAILY_MODULE_LIMIT=60
AI_DAILY_AUTOMATIC_LIMIT=20

# Background job worker (ingestion, extraction, hub refresh). Set false to run API-only.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000
# Jobs run at once (Drive downloads, AI processing). Jobs for the same file never overlap.
WORKER_CONCURRENCY=4

# Default local workspace and development actor.
WORKSPACE_NAME=Default workspace
DEV_ACTOR_ID=dev-user
DEV_ACTOR_NAME=Developer

# Development mode is local-only (one local actor, no sign-in); production startup rejects it.
AUTH_MODE=development
# Real sign-in (email link, Google, Microsoft, company SSO) with our own sessions:
# AUTH_MODE=accounts
# Signs session cookies and sign-in links. Generate with: openssl rand -base64 48
# AUTH_SECRET=...
# Public origin people open the app at (the web origin; /api is proxied on it). Defaults to the
# first CORS origin. Sign-in links and OAuth/SSO callbacks are built from it.
# AUTH_URL=http://localhost:5173
# Outgoing email for sign-in links and invitations (required in production). Without it, emails
# are written to the API log so you can open sign-in links locally.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM=ContextOS <no-reply@example.com>
# "Continue with Microsoft" (Entra ID app registration). Redirect URI:
#   <AUTH_URL>/api/v1/auth/callback/microsoft
# MICROSOFT_CLIENT_ID=...
# MICROSOFT_CLIENT_SECRET=...
# MICROSOFT_TENANT_ID=common
# Set CORS_ORIGINS to your HTTPS frontend origins in production.

# Google OAuth client: the Drive connector and "Continue with Google" sign-in. Register both
# redirect URIs on the web OAuth client:
#   <AUTH_URL>/api/v1/auth/callback/google            (sign-in)
#   GOOGLE_REDIRECT_URI below                          (Drive connector)
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/connectors/google-drive/callback
# A 32-byte key encoded as 64 hexadecimal characters. Keep it outside the DB.
# CONNECTOR_TOKEN_ENCRYPTION_KEY=...
# Largest file a Drive sync downloads (bytes), and the text kept per document (characters).
MAX_DOCUMENT_BYTES=50000000
MAX_SOURCE_TEXT_CHARS=2000000
# Parsing a PDF or Word file runs in a worker thread with these limits.
DOCUMENT_PARSE_TIMEOUT_MS=120000
DOCUMENT_PARSE_MEMORY_MB=512
# Files one Drive folder or shared drive may sync.
DRIVE_MAX_FILES_PER_SCOPE=20000
# Sections of ~120k characters the AI reads per document for the Knowledge Hub.
EXTRACTION_MAX_WINDOWS=4

# Public webhook receivers (POST /api/v1/webhooks/:provider) verify signatures with these.
# Each receiver answers 503 NOT_CONFIGURED until its secret is set.
# SLACK_SIGNING_SECRET=...
# GITHUB_WEBHOOK_SECRET=...
# JIRA_WEBHOOK_SECRET=...
# GOOGLE_WEBHOOK_TOKEN=...

# Maintenance sweeps (bounty expiry, nudges, invitation expiry, scheduled deletions) run between
# job polls at most this often.
MAINTENANCE_SWEEP_INTERVAL_MS=60000

# Rate limiting per client IP (set RATE_LIMIT_MAX=0 to disable).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Graceful shutdown: force exit after this many ms.
SHUTDOWN_TIMEOUT_MS=10000
