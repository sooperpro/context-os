# Copy to .env for local development. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug

# SQLite database file (directories are created automatically). Use ":memory:" for ephemeral.
DATABASE_URL=./data/contextos.db

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Background job worker (ingestion, extraction, hub refresh). Set false to run API-only.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000

# Default local workspace and development actor.
WORKSPACE_NAME=Default workspace
DEV_ACTOR_ID=dev-user
DEV_ACTOR_NAME=Developer

# Development mode is local-only; production startup rejects it.
AUTH_MODE=development
# For authenticated deployments set AUTH_MODE=clerk and configure:
# CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SECRET_KEY=sk_...
# Reserved for a future signed webhook receiver (not implemented yet):
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# Set CORS_ORIGINS to your HTTPS frontend origins in production.

# Google Drive OAuth: separate from signing in with Google via Clerk.
# Register this exact callback URL on the Google web OAuth client.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/connectors/google-drive/callback
# A 32-byte key encoded as 64 hexadecimal characters. Keep it outside the DB.
# CONNECTOR_TOKEN_ENCRYPTION_KEY=...
MAX_DOCUMENT_BYTES=10000000

# Public webhook receivers (POST /api/v1/webhooks/:provider) verify signatures with these.
# Each receiver answers 503 NOT_CONFIGURED until its secret is set.
# SLACK_SIGNING_SECRET=...
# GITHUB_WEBHOOK_SECRET=...
# JIRA_WEBHOOK_SECRET=...
# GOOGLE_WEBHOOK_TOKEN=...

# Maintenance sweeps (bounty expiry, nudges, invitation expiry, scheduled deletions) run between
# job polls at most this often.
MAINTENANCE_SWEEP_INTERVAL_MS=60000

# Rate limiting per client IP (set RATE_LIMIT_MAX=0 to disable).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Graceful shutdown: force exit after this many ms.
SHUTDOWN_TIMEOUT_MS=10000
