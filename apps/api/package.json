{
  "name": "@contextos/api",
  "version": "0.1.0",
  "private": true,
  "description": "ContextOS HTTP API: Hono on Node.js, Drizzle ORM + SQLite, Gemini-powered analysis",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.2",
    "@contextos/shared": "workspace:*",
    "@google/genai": "^2.29.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "googleapis": "^185.0.0",
    "hono": "^4.13.13",
    "hono-rate-limiter": "^0.5.4",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "pino": "^10.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@contextos/eslint-config": "workspace:*",
    "@contextos/tsconfig": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "pino-pretty": "^13.2.0",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
