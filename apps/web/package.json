{
  "name": "@contextos/web",
  "version": "0.1.0",
  "private": true,
  "description": "ContextOS web app: React 19, Vite, TypeScript, Tailwind CSS v4, shadcn/ui, TanStack Query, React Router",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ui:add": "shadcn add",
    "clean": "rm -rf dist coverage node_modules/.tmp"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/react": "^6.17.8",
    "@contextos/design-tokens": "workspace:*",
    "@contextos/shared": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@contextos/eslint-config": "workspace:*",
    "@contextos/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
