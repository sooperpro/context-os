    "@testing-library/user-event": "^14.6.8",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "jsdom": "^30.1.2",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "^8.3.4",
    "vitest": "catalog:"
  }
