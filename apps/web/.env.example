# Copy to .env for local development. Only VITE_* variables are exposed to the browser.

# Base URL for API requests. Keep "/api" to use the dev proxy / production reverse proxy.
VITE_API_BASE_URL=/api

# Clerk publishable key from the Clerk dashboard (safe to expose in browser code).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Where the Vite dev server proxies /api requests (server-side only, not exposed to the browser).
VITE_DEV_API_PROXY_TARGET=http://localhost:3000
