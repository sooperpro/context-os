meta {
  name: Create Flag
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/flags
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "projectId": "{{projectId}}",
    "targetType": "overview",
    "targetId": "{{projectId}}",
    "kind": "missing_context",
    "comment": "Add the owner and onboarding references."
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setEnvVar("flagId", body.id);
    bru.setEnvVar("flagVersion", body.version);
  }
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  See docs/backend-api-use-cases.md for required role, workflow and setup.
}

