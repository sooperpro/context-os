meta {
  name: Submit Correction
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/flags/{{flagId}}/corrections
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "type": "contextos_note",
    "text": "Proposed correction: document the local testing workflow and its owner."
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setEnvVar("correctionId", body.id);
    bru.setEnvVar("correctionVersion", body.version);
  }
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  See docs/backend-api-use-cases.md for required role, workflow and setup.
}

