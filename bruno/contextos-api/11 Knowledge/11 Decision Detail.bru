meta {
  name: Decision Detail
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/projects/{{projectId}}/decisions/{{decisionId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:pre-request {
  if (!bru.getEnvVar("decisionId")) bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  See docs/backend-api-use-cases.md for workflow prerequisites and required permissions.
  Skip is intentional when prerequisites or independent user sessions are not configured.
}

