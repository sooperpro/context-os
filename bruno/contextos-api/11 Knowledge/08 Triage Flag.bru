meta {
  name: Triage Flag
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/flags/{{flagId}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "version": {{flagVersion}},
    "status": "triaged",
    "reason": "Review the evidence"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    bru.setEnvVar("flagVersion", body.version);
  }
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  See docs/backend-api-use-cases.md for required role, workflow and setup.
}

