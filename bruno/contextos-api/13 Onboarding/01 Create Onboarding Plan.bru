meta {
  name: Create Onboarding Plan
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/probation/plans
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{learnerId}}",
    "mentorId": "{{mentorId}}",
    "projectId": "{{projectId}}",
    "startDate": "2026-10-13",
    "milestones": [
      {
        "key": "first_win",
        "title": "Complete the first verified project task",
        "dueOffsetDays": 30
      }
    ]
  }
}

script:pre-request {
  if (!bru.getEnvVar("managerAccessToken")) bru.runner.skipRequest();
  if (bru.getEnvVar("managerAccessToken")) req.setHeader("Authorization", "Bearer " + bru.getEnvVar("managerAccessToken"));
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setEnvVar("planVersion", body.version);
  }
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  See docs/backend-api-use-cases.md for required role, workflow and setup.
  This request is skipped unless its prerequisite environment variable is configured: managerAccessToken.
}

