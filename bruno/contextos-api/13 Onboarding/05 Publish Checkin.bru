meta {
  name: Publish Checkin
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/probation/employees/{{learnerId}}/checkins
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "wentWell": "Understands project context",
    "toImprove": "Review decisions",
    "supportNeeded": "Meet the domain owner"
  }
}

script:pre-request {
  if (!bru.getEnvVar("managerAccessToken")) bru.runner.skipRequest();
  if (bru.getEnvVar("managerAccessToken")) req.setHeader("Authorization", "Bearer " + bru.getEnvVar("managerAccessToken"));
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setEnvVar("checkinId", body.id);
    bru.setEnvVar("checkinVersion", body.version);
  }
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  See docs/backend-api-use-cases.md for required role, workflow and setup.
  This request is skipped unless its prerequisite environment variable is configured: managerAccessToken.
}

