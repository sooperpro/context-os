meta {
  name: Mark Notification Read
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/notifications/{{notificationId}}/read
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:pre-request {
  if (!bru.getEnvVar("notificationId")) bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  See docs/backend-api-use-cases.md for workflow prerequisites and required permissions.
  Skip is intentional when prerequisites or independent user sessions are not configured.
}

