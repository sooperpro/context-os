meta {
  name: List My Notifications
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/notifications
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.getStatus() === 200) bru.setEnvVar("notificationId", res.getBody().items[0]?.id || "");
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  See docs/backend-api-use-cases.md for required role, workflow and setup.
}

