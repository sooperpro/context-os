meta {
  name: Assign Published Path
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/learning/paths/{{pathId}}/assign
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{learnerId}}",
    "mentorId": "{{mentorId}}",
    "startDate": "2026-10-13"
  }
}

script:pre-request {
  if (!bru.getEnvVar("learnerId")) bru.runner.skipRequest();
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setEnvVar("pathAssignmentId", body.id);
  }
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  See docs/backend-api-use-cases.md for required role, workflow and setup.
  This request is skipped unless its prerequisite environment variable is configured: learnerId.
}

