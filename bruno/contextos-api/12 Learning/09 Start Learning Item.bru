meta {
  name: Start Learning Item
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/learning/assignments/{{pathAssignmentId}}/items/{{learningItemId}}/start
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:pre-request {
  if (!bru.getEnvVar("learningItemId")) bru.runner.skipRequest();
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setEnvVar("progressVersion", body.version);
    bru.setEnvVar("progressId", body.id);
  }
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  See docs/backend-api-use-cases.md for required role, workflow and setup.
  This request is skipped unless its prerequisite environment variable is configured: learningItemId.
}

