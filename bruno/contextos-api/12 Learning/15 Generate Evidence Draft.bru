meta {
  name: Generate Evidence Draft
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/learning/paths/generate
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "projectId": "{{projectId}}",
    "title": "Evidence-backed onboarding draft",
    "roleFamily": "engineering"
  }
}

script:pre-request {
  if (!bru.getEnvVar("contextItemId")) bru.runner.skipRequest();
}

tests {
  test("Creates a labelled evidence-template draft", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data.generationMethod).to.equal("evidence_template_v2");
  });
}
