meta {
  name: Assignment Progress
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/learning/assignments/{{pathAssignmentId}}/progress
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:pre-request {
  if (!bru.getEnvVar("pathAssignmentId")) bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  See docs/backend-api-use-cases.md for required role, workflow and setup.
  This request is skipped unless its prerequisite environment variable is configured: pathAssignmentId.
}

