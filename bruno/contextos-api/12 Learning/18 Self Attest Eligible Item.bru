meta {
  name: Self Attest Eligible Item
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/learning/assignments/{{pathAssignmentId}}/items/{{attestableItemId}}/attest
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "version": {{progressVersion}}
  }
}

script:pre-request {
  if (!bru.getEnvVar("learnerAccessToken") || !bru.getEnvVar("pathAssignmentId") || !bru.getEnvVar("attestableItemId")) bru.runner.skipRequest();
  else req.setHeader("Authorization", "Bearer " + bru.getEnvVar("learnerAccessToken"));
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  See docs/backend-api-use-cases.md for workflow prerequisites and required permissions.
  Skip is intentional when prerequisites or independent user sessions are not configured.
}

