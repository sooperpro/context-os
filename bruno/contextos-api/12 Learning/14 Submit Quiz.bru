meta {
  name: Submit Quiz
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/learning/assignments/{{pathAssignmentId}}/items/{{learningItemId}}/quiz/submit
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "version": {{progressVersion}},
    "answers": [
      0,
      0,
      0
    ]
  }
}

script:pre-request {
  if (!bru.getEnvVar("quizItemId")) bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  See docs/backend-api-use-cases.md for required role, workflow and setup.
  This request is skipped unless its prerequisite environment variable is configured: quizItemId.
}

