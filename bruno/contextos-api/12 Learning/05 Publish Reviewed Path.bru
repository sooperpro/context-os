meta {
  name: Publish Reviewed Path
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/learning/paths/{{pathId}}/publish
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "version": {{pathVersion}}
  }
}

script:pre-request {
  if (!bru.getEnvVar("reviewerAccessToken")) bru.runner.skipRequest();
  if (bru.getEnvVar("reviewerAccessToken")) req.setHeader("Authorization", "Bearer " + bru.getEnvVar("reviewerAccessToken"));
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    bru.setEnvVar("pathVersion", body.version);
  }
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  See docs/backend-api-use-cases.md for required role, workflow and setup.
  This request is skipped unless its prerequisite environment variable is configured: reviewerAccessToken.
}

