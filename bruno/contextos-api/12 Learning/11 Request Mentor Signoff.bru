meta {
  name: Request Mentor Signoff
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/learning/assignments/{{pathAssignmentId}}/items/{{learningItemId}}/signoff/request
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:pre-request {
  if (!bru.getEnvVar("signoffItemId")) bru.runner.skipRequest();
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    bru.setEnvVar("progressVersion", body.version);
  }
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  See docs/backend-api-use-cases.md for required role, workflow and setup.
  This request is skipped unless its prerequisite environment variable is configured: signoffItemId.
}

