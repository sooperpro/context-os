meta {
  name: Promote Answer
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/ask/messages/{{answerId}}/promote
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  { "note": "Useful for new joiners" }
}

script:pre-request {
  const value = bru.getEnvVar("answerId");
  if (!value || value === "false") bru.runner.skipRequest();
}

script:post-response {
  if (res.getStatus() === 201 || res.getStatus() === 200) bru.setEnvVar("promotionId", res.getBody().id);
}

tests {
  test("Expected response", function () {
    expect([200, 201, 202, 204]).to.include(res.getStatus());
  });
}

docs {
  Proposes the answer as a hub FAQ claim; needs domain-owner verification.
}
