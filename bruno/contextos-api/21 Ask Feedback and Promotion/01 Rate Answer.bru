meta {
  name: Rate Answer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/ask/messages/{{answerId}}/feedback
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  { "rating": "up" }
}

script:pre-request {
  const value = bru.getEnvVar("answerId");
  if (!value || value === "false") bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect([200, 201, 202, 204]).to.include(res.getStatus());
  });
}

docs {
  Asker only. Thumbs-down requires a reason: wrong, outdated, missing_source, not_helpful, leaked.
}
