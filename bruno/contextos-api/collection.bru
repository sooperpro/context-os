headers {
  Accept: application/json
}

script:pre-request {
  const cookie = bru.getEnvVar("sessionCookie");
  if (cookie) req.setHeader("Cookie", cookie);
  else req.deleteHeader("Cookie");
}

docs {
  Use Local for development or a git-ignored private environment for a real session cookie.
  Optional multi-user and live-provider requests are skipped until their prerequisites are configured.
}
