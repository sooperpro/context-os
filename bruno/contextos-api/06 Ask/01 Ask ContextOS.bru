meta {
  name: Ask ContextOS
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/projects/{{projectId}}/ask
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "question": "Why is billing moving to a dedicated ledger service?"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setEnvVar("answerId", body.id);
  }
}

tests {
  test("Returns an evidence-aware answer", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().confidence).to.be.a("string");
    if (res.getBody().confidence !== "insufficient") expect(res.getBody().citations.length).to.be.greaterThan(0);
  });
}

docs {
  Ask is synchronous and may take longer than the other requests. Saves answerId for feedback.
}
