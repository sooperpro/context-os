meta {
  name: List Question History
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/projects/{{projectId}}/questions
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("Returns answer history", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().items).to.be.an("array");
  });
}
