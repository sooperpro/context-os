meta {
  name: Clear Member Organization
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/users/{{managedUserId}}/organization
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"departmentId": null, "teamId": null}
}

script:pre-request {
  if (bru.getEnvVar("enableOrgMutation") !== "true" || !bru.getEnvVar("managedUserId")) bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Use only a disposable development tenant. Workspace creation and member organization mutation are opt-in.
  See docs/backend-api-use-cases.md for access rules and configuration.
}

