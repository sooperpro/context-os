meta {
  name: Delete Department
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/org/departments/{{departmentId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:pre-request {
  if (!bru.getEnvVar("departmentId")) bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Use only a disposable development tenant. Workspace creation and member organization mutation are opt-in.
  See docs/backend-api-use-cases.md for access rules and configuration.
}

