meta {
  name: Create Review Cycle
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/epm/review-cycles
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  { "name": "H1 2026", "periodStart": "2026-01-01", "periodEnd": "2026-06-30", "participantIds": ["{{managedUserId}}"], "questions": ["What went well?"] }
}

script:pre-request {
  const value = bru.getEnvVar("managedUserId");
  if (!value || value === "false") bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect([200, 201, 202, 204]).to.include(res.getStatus());
  });
}

docs {
  Owner or review_cycle_admin assignment.
}
