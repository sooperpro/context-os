meta {
  name: Give Kudos
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/gamification/kudos
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  { "toUserId": "{{managedUserId}}", "message": "Thanks for the walkthrough" }
}

script:pre-request {
  const value = bru.getEnvVar("managedUserId");
  if (!value || value === "false") bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect([200, 201, 202, 204]).to.include(res.getStatus());
  });
}

docs {
  5 per month, 2 per recipient, never to yourself (AG-7).
}
