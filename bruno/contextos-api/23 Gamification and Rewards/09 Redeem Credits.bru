meta {
  name: Redeem Credits
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/rewards/redeem
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  { "itemId": "{{rewardItemId}}", "note": "Please" }
}

script:pre-request {
  const value = bru.getEnvVar("rewardItemId");
  if (!value || value === "false") bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect([200, 201, 202, 204]).to.include(res.getStatus());
  });
}

docs {
  Debits KC immediately; approval by a rewards_approver assignment.
}
