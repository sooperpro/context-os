meta {
  name: Create Workspace
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/workspaces
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"name": "Bruno Workspace", "slug": "bruno-workspace-{{projectId}}", "primaryDomain": "example.com", "region": "us-east-1"}
}

script:pre-request {
  if (bru.getEnvVar("enableWorkspaceCreation") !== "true") bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Use only a disposable development tenant. Workspace creation and member organization mutation are opt-in.
  See docs/backend-api-use-cases.md for access rules and configuration.
}

