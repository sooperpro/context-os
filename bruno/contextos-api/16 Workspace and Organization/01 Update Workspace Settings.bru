meta {
  name: Update Workspace Settings
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/workspaces/current
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"version": {{workspaceVersion}}, "timezone": "UTC"}
}

script:post-response {
  if (res.getStatus() === 200) bru.setEnvVar("workspaceVersion", res.getBody().version);
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Use only a disposable development tenant. Workspace creation and member organization mutation are opt-in.
  See docs/backend-api-use-cases.md for access rules and configuration.
}

