meta {
  name: Import Selected File
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/connectors/{{connectionId}}/import
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "projectId": "{{projectId}}",
    "fileId": "{{driveFileId}}"
  }
}

script:pre-request {
  if (!bru.getEnvVar("driveFileId")) bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  See docs/backend-api-use-cases.md for required role, workflow and setup.
  This request is skipped unless its prerequisite environment variable is configured: driveFileId.
}

