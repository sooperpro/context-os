meta {
  name: Start Drive OAuth
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/connectors/google-drive/authorize
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:pre-request {
  if (bru.getEnvVar("enableLiveConnectors") !== "true") bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  See docs/backend-api-use-cases.md for required role, workflow and setup.
  This request is skipped unless its prerequisite environment variable is configured: live.
}

