meta {
  name: Create Thread
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/ask/threads
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "projectId": "{{projectId}}",
    "title": "Bruno onboarding questions"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();
    bru.setEnvVar("threadId", body.id);
  }
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  See docs/backend-api-use-cases.md for required role, workflow and setup.
}

