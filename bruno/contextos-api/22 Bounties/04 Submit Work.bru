meta {
  name: Submit Work
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/bounties/{{bountyId}}/submit
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  { "version": {{bountyVersion}}, "note": "Guide published", "evidenceUrl": "https://example.com/guide" }
}

script:pre-request {
  const value = bru.getEnvVar("learnerAccessToken") && bru.getEnvVar("bountyId");
  if (!value || value === "false") bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect([200, 201, 202, 204]).to.include(res.getStatus());
  });
}

docs {
  Claimant submits for review.
}
