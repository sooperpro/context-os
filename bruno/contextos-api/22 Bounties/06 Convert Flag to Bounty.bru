meta {
  name: Convert Flag to Bounty
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/flags/{{bountyFlagId}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  { "version": {{bountyFlagVersion}}, "status": "bounty_created", "rewardRp": 25 }
}

script:pre-request {
  const value = bru.getEnvVar("bountyFlagId");
  if (!value || value === "false") bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect([200, 201, 202, 204]).to.include(res.getStatus());
  });
}

docs {
  Domain owner converts a triaged flag into a draft bounty; flagger and co-reporters are credited.
}
