meta {
  name: Claim Bounty
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/bounties/{{bountyId}}/claim
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  { "version": {{bountyVersion}} }
}

script:pre-request {
  const value = bru.getEnvVar("learnerAccessToken") && bru.getEnvVar("bountyId");
  if (!value || value === "false") bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect([200, 201, 202, 204]).to.include(res.getStatus());
  });
}

docs {
  One claimant; 7-day claim; sponsors cannot claim their own (AG-10).
}
