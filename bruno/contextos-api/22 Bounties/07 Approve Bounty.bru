meta {
  name: Approve Bounty
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/bounties/{{bountyId}}/approve
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  { "version": {{bountyVersion}}, "approved": true, "note": "Great work" }
}

script:pre-request {
  const value = bru.getEnvVar("learnerAccessToken") && bru.getEnvVar("bountyId");
  if (!value || value === "false") bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect([200, 201, 202, 204]).to.include(res.getStatus());
  });
}

docs {
  Verifier/sponsor/domain owner, never the claimant (AG-1). Posts bounty_completed RP and resolves a linked flag.
}
