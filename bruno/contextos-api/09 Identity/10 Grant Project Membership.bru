meta {
  name: Grant Project Membership
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/projects/{{projectId}}/memberships
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{managedUserId}}"
  }
}

script:pre-request {
  if (!bru.getEnvVar("managedUserId")) bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  See docs/backend-api-use-cases.md for required role, workflow and setup.
  This request is skipped unless its prerequisite environment variable is configured: managedUserId.
}

