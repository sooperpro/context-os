meta {
  name: Revoke Manual Source Access
  type: http
  seq: 12
}

delete {
  url: {{baseUrl}}/projects/{{projectId}}/sources/{{sourceId}}/access/{{managedUserId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:pre-request {
  if (!bru.getEnvVar("managedUserId")) bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  See docs/backend-api-use-cases.md for required role, workflow and setup.
  This request is skipped unless its prerequisite environment variable is configured: managedUserId.
}

