meta {
  name: Get Source
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/projects/{{projectId}}/sources/{{sourceId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("Returns the imported source", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getEnvVar("sourceId"));
  });
}
