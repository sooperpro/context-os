meta {
  name: Get Project
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/projects/{{projectId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("Returns the selected project", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getEnvVar("projectId"));
  });
}
