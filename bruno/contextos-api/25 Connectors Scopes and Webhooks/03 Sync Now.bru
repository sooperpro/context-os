meta {
  name: Sync Now
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/connectors/{{connectionId}}/sync
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {}
}

script:pre-request {
  const value = bru.getEnvVar("connectionId");
  if (!value || value === "false") bru.runner.skipRequest();
}

tests {
  test("Expected response", function () {
    expect([200, 201, 202, 204]).to.include(res.getStatus());
  });
}

docs {
  Queues a sync per selected scope; 10-minute cooldown per scope.
}
