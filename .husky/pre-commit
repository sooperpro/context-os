# GUI Git clients may inherit an older Node installation without pnpm.
# When nvm is available, use the version declared by this project's .nvmrc.
if [ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]; then
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  . "$NVM_DIR/nvm.sh" --no-use
  nvm use --silent || {
    echo "pre-commit: Install the Node version in .nvmrc with 'nvm install'." >&2
    exit 1
  }
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-commit: pnpm is missing for the active Node version. Run 'corepack enable' and retry." >&2
  exit 1
fi

pnpm lint-staged
